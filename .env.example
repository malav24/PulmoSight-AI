# Copy this file to .env (same folder) and edit. It is read automatically by the Python code
# (ml/utils/config.py) - real environment variables take precedence over .env values.
# Paths are relative to the project root unless absolute.

# ---- Data and model locations -------------------------------------------------------
RFRR_RSNA_ROOT=data/rsna            # folder containing stage_2_train_labels.csv
RFRR_NIH_ROOT=data/nih              # folder containing Data_Entry_2017_v2020.csv
RFRR_CHECKPOINT_ROOT=checkpoints    # contains hybrid/, baselines/, calibration/
RFRR_OUTPUT_ROOT=outputs            # metrics/, predictions/, visualizations/, reports/, logs/

# ---- Compute ----------------------------------------------------------------------------
RFRR_DEVICE=auto                    # auto | cuda | cpu | mps

# ---- Web API (inference) ------------------------------------------------------------------
RFRR_DEFAULT_MODEL=model_b
RFRR_MC_DROPOUT_SAMPLES=20          # repeated predictions for the uncertainty estimate (fewer = faster)
RFRR_ABSTAIN_UNCERTAINTY=0.15       # MC-dropout std above which the system abstains
RFRR_MAX_UPLOAD_MB=25
RFRR_MAX_IMAGE_PIXELS=40000000
RFRR_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173
RFRR_STORE_ANALYSES=true            # keep 384-px derived images + outputs for reports (originals never stored)
RFRR_MAX_STORED_ANALYSES=200

# ---- Optional caches for ImageNet backbone weights downloaded by timm -----------------------
# HF_HOME=C:/Users/<you>/.cache/huggingface
# TORCH_HOME=C:/Users/<you>/.cache/torch
